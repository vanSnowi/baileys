{
  "name": "@vansnowi/baileys",
  "type": "module",
  "version": "1.5.7",
  "description": "Self-modified fork of Baileys (based on @whiskeysockets/baileys 7.0.0-rc13) — ships prebuilt, installable as a normal semver dependency.",
  "keywords": [
    "whatsapp",
    "automation",
    "baileys"
  ],
  "homepage": "https://github.com/vanSnowi/baileys",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanSnowi/baileys.git"
  },
  "bugs": {
    "url": "https://github.com/vanSnowi/baileys/issues"
  },
  "license": "MIT",
  "author": "Rajeh Taher",
  "main": "lib/index.js",
  "files": [
    "lib/**/*",
    "WAProto/**/*",
    "engine-requirements.js"
  ],
  "scripts": {
    "preinstall": "node ./engine-requirements.js",
    "prepare": "node WAProto/compiler.js"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "axios": "^1.7.9",
    "cache-manager": "^7.2.4",
    "futoin-hkdf": "^1.5.3",
    "libsignal": "^6.0.0",
    "long": "^5.2.3",
    "lru-cache": "^11.1.0",
    "music-metadata": "^11.12.3",
    "p-queue": "^9.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.5.6",
    "uuid": "^11.0.5",
    "whatsapp-rust-bridge": "0.5.4",
    "ws": "^8.13.0"
  },
  "peerDependencies": {
    "audio-decode": "^2.1.3",
    "jimp": "^1.6.1",
    "link-preview-js": "^3.0.0",
    "sharp": "*"
  },
  "peerDependenciesMeta": {
    "audio-decode": {
      "optional": true
    },
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
